theme=Ayu
font-size=13
window-padding-x=6,2

macos-icon=chalkboard

keybind=shift+up=scroll_page_lines:-1
keybind=shift+down=scroll_page_lines:1
keybind=ctrl+shift+up=scroll_page_lines:-5
keybind=ctrl+shift+down=scroll_page_lines:5

keybind=ctrl+shift+space>j=goto_split:down
keybind=ctrl+shift+space>down=goto_split:down
keybind=ctrl+shift+space>k=goto_split:up
keybind=ctrl+shift+space>up=goto_split:up
keybind=ctrl+shift+space>h=goto_split:left
keybind=ctrl+shift+space>left=goto_split:left
keybind=ctrl+shift+space>l=goto_split:right
keybind=ctrl+shift+space>right=goto_split:right
